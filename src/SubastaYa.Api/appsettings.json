{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "SubastaYa",
    "Audience": "SubastaYaClientes",
    "ExpiracionMinutos": 480
  },
  "AntiSniping": {
    "UmbralSegundos": 60,
    "ExtensionMinutos": 2
  },
  "Publicacion": {
    "DuracionMaximaDias": 365,
    "ToleranciaInicioMinutos": 5
  },
  "Worker": {
    "IntervaloSegundos": 10
  },
  "AllowedHosts": "*"
}
